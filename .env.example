# Database
MONGODB_URI=mongodb://localhost:27017/fitness-app
PORT=3000

# Firebase Admin SDK (get from Firebase Console → Project Settings → Service Accounts)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-fitness-app-bucket

# OpenAI
OPENAI_API_KEY=your-openai-api-key
# Chat model for plan generation (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Redis (rate-limit storage + BullMQ job queues).
# For local dev without Redis, set REDIS_DISABLED=true
# (uses in-memory limits; counters reset when the server restarts).
# Local only. On Render/cloud, use the URL from your Redis provider (never 127.0.0.1).
REDIS_URL=
# REDIS_DISABLED=true

# BullMQ — uses same REDIS_URL as rate limiting
# BULLMQ_CONCURRENCY=2    # worker concurrency per queue (default 1)

# Trust proxy depth (set to 1 behind a single load balancer)
# TRUST_PROXY=1

# Rate-limit tuning (all optional — sensible defaults are built in)
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AI_GEN_WINDOW_MS=3600000
# RATE_LIMIT_AI_GEN_MAX=5
# RATE_LIMIT_PHOTO_WINDOW_MS=3600000
# RATE_LIMIT_PHOTO_MAX=6
# RATE_LIMIT_POLL_WINDOW_MS=60000
# RATE_LIMIT_POLL_MAX=60

# Optional: Node environment
NODE_ENV=development

# --- Render (production) ---
# PORT is set automatically by Render — do not set it in the dashboard unless debugging.
# TRUST_PROXY=1 — required for correct client IP / rate limits behind Render’s proxy (see render.yaml).
# REDIS_URL — create a Render Redis instance (or Upstash) and paste the URL; do NOT set REDIS_DISABLED.
# BullMQ workers run inside this web process (see src/server.js); one Web Service is enough.
